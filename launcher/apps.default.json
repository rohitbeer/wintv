{
  "_comment": "Shipped defaults. A household adds C:\\ProgramData\\WinTV\\apps.json: any top-level key there replaces the one here, and addApps (with \"after\": id) / removeApps edit the app list. kind: web = browser app window with its own profile; browser = full browser; exe = program; uri = protocol link; settings = WinTV Settings; power = power menu. drm: true turns on Widevine in that tile's Brave profile. lockScreen: minutes idle on the home screen before the clock screen (0 = never), and minutes after which waking asks who is watching.",
  "browserCandidates": [
    "%ProgramFiles%\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
    "%ProgramFiles(x86)%\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
    "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
    "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe",
    "%LOCALAPPDATA%\\Google\\Chrome\\Application\\chrome.exe"
  ],
  "homeKeys": [
    "Control+Escape",
    "Super+Escape",
    "Control+Alt+H"
  ],
  "lockScreen": {
    "afterMinutes": 5,
    "askWhoAfterMinutes": 30
  },
  "profiles": [
    {
      "id": "home",
      "name": "Home",
      "colors": [
        "#5e5ce6",
        "#1c1c40"
      ]
    },
    {
      "id": "guest",
      "name": "Guest",
      "guest": true,
      "colors": [
        "#636366",
        "#1c1c1e"
      ]
    }
  ],
  "apps": [
