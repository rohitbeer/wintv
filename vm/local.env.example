# Settings for the vm/ scripts on this machine. Copy to vm/local.env (git
# ignores it) next to the scripts you run, and fill in. Keep it private.

# Proxmox container that builds the payload (pct exec), and the repo inside it.
WINTV_BUILD_CT=
WINTV_REPO=/srv/wintv

# File with the admin password baked into the answer file. Created with a
# random password if missing. It ends up on the install stick, so treat the
# stick like the password.
WINTV_SECRET=$HOME/.wintv/admin-password.txt

# Optional: your household's site file (profiles, extra tiles, language,
# time zone). Start from sites/example.json; keep your copy outside the repo.
WINTV_SITE=

# Firewall rules for the test VM, in Proxmox format (vm/firewall.example.fw).
WINTV_FIREWALL=
